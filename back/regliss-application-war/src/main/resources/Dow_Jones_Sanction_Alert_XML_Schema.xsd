                <xs:element ref="Description2List"/>
                <xs:element ref="Description3List"/>
                <xs:element ref="ReferenceGroupList"/>
                <xs:element ref="SanctionsReferencesList"/>
                <xs:element ref="IdentificationTypeList"/>
                <xs:element ref="DateTypeList"/>
                <xs:element ref="ReferenceGroupLanguagesList"/>
                <xs:element ref="ScriptLanguageList"/>
                <xs:element ref="RelationshipList" minOccurs="0"/>
                <xs:element ref="Records"/>
                <xs:element ref="Associations" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:NMTOKEN">
                        <xs:maxLength value="11"/>
                        <xs:enumeration value="incremental"/>
                        <xs:enumeration value="full"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="date" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="12"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="ContentRestriction">
        <xs:restriction base="xs:string">
            <xs:maxLength value="255"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="NameContentRestriction">
        <xs:restriction base="xs:string">
